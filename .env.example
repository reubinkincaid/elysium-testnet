# Template only — no real values. Copy to .env and fill in locally.
# .env is gitignored and must never be committed.
#
# Conduit API key — register at https://app.conduit.xyz/nodes
# Free tier: 100M compute units/month, no rate limit.
# Append the key as the last path segment of the Conduit RPC URL.
CONDUIT_API_KEY=

# 0xArchive API key (Pro tier for L4 channels).
# Accepts this name or the legacy OX_ARCHIVE_API_KEY; see src/config.ts.
# A NEVER-QUITTED-WALLET private key goes here only. Never commit it.
OXARCHIVE_API_KEY=

# Throwaway Elysium testnet key, generated by: bun run wallet
# Testnet gas only. Never hold a mainnet asset or an airdrop-eligible
# position at this address.
ELYSIUM_TESTNET_KEY=

# Optional endpoint overrides
ELYSIUM_RPC=https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_FEED=wss://relay-elysium-testnet.t.conduit.xyz/
