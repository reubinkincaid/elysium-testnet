#!/usr/bin/env bash
# pre-commit — block secrets before they enter git history.
#
# Two layers, because they catch different things:
#
#   1. EXACT MATCH against the live values in .env. This is the strong check.
#      A key that only ever lives in .env can still be pasted into a source
#      file by accident, and no regex reliably catches an unknown 64-char
#      secret. Reading the real values and grepping for them is exact.
#
#   2. gitleaks for generic patterns (provider key formats, JWTs, AWS keys,
#      private key blocks). This catches secrets from sources layer 1 has
#      never seen, e.g. a key typed into a file for the first time.
#
# Both must pass. On failure the commit is aborted and the offending files
# are named. Bypass with: git commit --no-verify
#   — which you should not do. It is the only way a secret gets in.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

ENV_FILE=".env"
RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
NC=$'\033[0m'

fail() {
  echo ""
  echo "${RED}✗ pre-commit: secret check FAILED${NC}"
  echo "  commit aborted. Nothing was staged or written."
  echo ""
  echo "  To inspect:  git diff --staged"
  echo "  To allow:    git commit --no-verify   (avoid unless certain)"
  echo ""
  exit 1
}

# ---------------------------------------------------------------- layer 1
# Exact match on every value defined in .env. Never echo a secret value.
if [[ -f "$ENV_FILE" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^# ]] && continue
    [[ "$line" != *=* ]] && continue
    name="${line%%=*}"
    value="${line#*=}"
    value="${value%\"}"; value="${value#\"}"
    value="${value%\'}"; value="${value#\'}"
    # Layer 1 is strongest for actual credentials. But some .env values are
    # public by nature — the documented RPC and sequencer-feed endpoints are
    # printed in Kinetiq's own docs and belong in workflows and READMEs.
    # Treating those as secrets produces false positives on legitimate files,
    # and a hook that cries wolf gets bypassed, which is how a real key gets
    # in. So: only treat a value as a secret if it looks like a credential.
    #
    # A credential is long and has no URL/host shape. A public endpoint has
    # "://" in it. Values under MIN_SECRET_LEN are ignored outright.
    MIN_SECRET_LEN=16
    [[ ${#value} -lt $MIN_SECRET_LEN ]] && continue
    [[ "$value" == *"://"* ]] && continue

    # search the staged diff, not the working tree, so we only block on
    # content that is actually about to be committed
    #
    # Templates are exempt: .env.example legitimately contains the public
    # RPC/feed URLs, which also appear in .env. Flagging them would train
    # you to reach for --no-verify, which is exactly how a real key slips
    # through. It holds no secret by construction — it is the file the
    # README tells people to copy FROM.
    #
    # `other_staged` is empty when the only staged file is a template, and
    # in that case a hit is expected and ignored.
    other_staged=$(git diff --staged --name-only | grep -vE '(^|/)\.env\.example$' | head -1)
    if [[ -n "$other_staged" ]] \
        && git diff --staged --unified=0 2>/dev/null | grep -q -F -- "$value"; then
      echo ""
      echo "${RED}✗ value of ${YELLOW}${name}${NC} ${RED}appears in this commit${NC}"
      echo "  matched file(s):"
      git diff --staged --name-only | while read -r f; do
        if git show ":$f" 2>/dev/null | grep -q -F -- "$value"; then
          echo "    $f"
        fi
      done
      fail
    fi
  done < "$ENV_FILE"
fi

# ---------------------------------------------------------------- layer 2
# Generic pattern scan over staged content.
if command -v gitleaks >/dev/null 2>&1; then
  STAGED_LIST=$(git diff --staged --name-only --diff-filter=ACMR)
  TMPDIR_SCAN=$(mktemp -d)
  trap 'rm -rf "$TMPDIR_SCAN"' EXIT
  found_pattern=0
  while read -r f; do
    [[ -z "$f" ]] && continue
    [[ -f "$f" ]] || continue
    mkdir -p "$TMPDIR_SCAN/$(dirname "$f")"
    git show ":$f" > "$TMPDIR_SCAN/$f" 2>/dev/null || true
  done <<< "$STAGED_LIST"

  if [[ -n "$STAGED_LIST" && -d "$TMPDIR_SCAN" ]]; then
    # Capture the exit code BEFORE branching. An `if cmd; then / elif [[ $? -eq 2 ]]`
    # reads `$?` from the *condition*, not from cmd, so the branch never fires
    # for exit 2 the way it looks like it should.
    gitleaks detect --no-git --source "$TMPDIR_SCAN" --redact --exit-code 2 \
      -c "$REPO_ROOT/.gitleaks.toml" >/dev/null 2>&1
    gl_status=$?
    if [[ "$gl_status" -eq 2 ]]; then
      echo ""
      echo "${RED}✗ gitleaks found a secret pattern in staged content${NC}"
      gitleaks detect --no-git --source "$TMPDIR_SCAN" --redact -c "$REPO_ROOT/.gitleaks.toml" 2>/dev/null \
        | grep -E 'Rule:|Secret:|File:' | sed 's/^/  /' | head -20 || true
      found_pattern=1
    fi
  fi
  [[ "$found_pattern" == "1" ]] && fail
fi

# ---------------------------------------------------------------- layer 3
# Refuse to commit a real .env under any circumstance.
STAGED_NAMES=$(git diff --staged --name-only)
for f in $STAGED_NAMES; do
  case "$f" in
    .env|*.env|*.env.*|*.key|*.pem|id_rsa|id_ed25519)
      if [[ "$f" != ".env.example" ]]; then
        echo ""
        echo "${RED}✗ refusing to commit ${YELLOW}$f${NC}${RED} — looks like a secret file${NC}"
        echo "  .env.example is the tracked template; real .env must stay local."
        fail
      fi
      ;;
  esac
done

echo "${GREEN}✓${NC} pre-commit: no secrets in staged changes"
exit 0
